<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/white"
    tools:context=".viewTabs">


    <Button
        android:id="@+id/normaltabs"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#BDBDBD"
        android:text="Normal tabs"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/doubletabs"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#BDBDBD"
        android:text="Double tabs"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <Button
        android:id="@+id/goback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#BDBDBD"
        android:text="Go back"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scroll" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="600dp"
        android:background="#E4E4E4"
        app:layout_constraintBottom_toTopOf="@+id/goback"
        app:layout_constraintTop_toBottomOf="@+id/normaltabs"
        tools:layout_editor_absoluteX="16dp">

        <LinearLayout
            android:id="@+id/linear"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>